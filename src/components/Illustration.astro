  </>}
  {kind === 'hollow-knight' && <>
    <rect x="83" y="76" width="259" height="206" rx="12" stroke="#b9c3ba" stroke-width="2"/>
    <path d="M83 103h259m-232-14h4m9 0h4m9 0h4" stroke="#b9c3ba" stroke-width="3"/>
