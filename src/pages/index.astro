---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Robot from '../components/Robot.astro';
import Illustration from '../components/Illustration.astro';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
const experience = [
  { name: 'CSIRO', title: 'Undergraduate studentship', date: 'JUN 2025 — PRESENT', text: 'Collaboratively developing ManuMentor, a manufacturing AI assistant. Connecting documents, test data and knowledge graphs; supporting research and ethics trials.', tag:'APPLIED AI / RESEARCH' },
  { name: 'Orica', title: 'Algorithmics Developer · Monash IIP', date: 'NOV 2025 — APR 2026', text: 'Drone-footage annotation, YOLO model training and a computer-vision prototype. Assisted with drone electronics and flight planning using ArduPilot, PX4 and ROS 2.', tag:'COMPUTER VISION / DRONES' },
  { name: 'Monash Automation', title: 'Mechatronics Engineer', date: 'APR 2026 — PRESENT', text: 'From reinforcement learning to soldering and robot assembly. Working across prototypes, KUKA arms, cameras, LiDAR and the practical upkeep of a robotics lab.', tag:'ROBOTICS / HARDWARE' },
  { name: 'Monash Deep Neuron', title: 'Project Team Member / RL Project Lead', date: 'MAR 2023 — APR 2026', text: 'Led game-agent RL work, built GAN and skin-lesion computer-vision projects, and helped develop Bookworm GPT to turn learning materials into student notes.', tag:'MACHINE LEARNING / TEAMWORK' },
];
---
<Layout>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow"><span class="status-dot" aria-hidden="true"></span> MECHATRONICS · ROBOTICS · AI</p>
      <h1 id="hero-title">Building robots.<br />Teaching<br /><em>machines.</em></h1>
      <p class="hero-intro">Hey, I’m Abbas Quettawala. A final-year mechatronics student at Monash, happiest at the intersection of <strong>physical hardware and intelligent software.</strong></p>
      <div class="hero-actions"><a class="button primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a><a class="text-link" href="/resume.pdf" download="Abbas_Quettawala_Resume.pdf">Resume <span aria-hidden="true">↓</span></a></div>
      <div class="hero-footnote"><span>BASED IN MELBOURNE, AU</span><span>ALWAYS A WORK IN PROGRESS ↗</span></div>
    </div>
    <Robot />
  </section>

  <div class="capability-strip"><div class="container"><span>CAD → HARDWARE</span><span aria-hidden="true">✳</span><span>CODE → CONTROL</span><span aria-hidden="true">✳</span><span>SIMULATION → LEARNING</span><span aria-hidden="true">✳</span><span>BUILD. TEST. REPEAT.</span></div></div>

  <section class="work-section container section" id="work" aria-labelledby="work-title">
    <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="work-title">Ideas, made tangible<span class="orange">.</span></h2></div><p>Some move. Some learn.<br />All teach me something.</p></div>
    <div class="work-toolbar"><span class="eyebrow">FOUR PROJECTS. DIFFERENT CHALLENGES.</span><div class="filters" role="group" aria-label="Filter projects" hidden data-filters>{['All', 'Robotics', 'AI/software'].map((category)=><button type="button" data-filter={category} aria-pressed={category === 'All'}>{category}</button>)}</div></div>
    <p class="sr-only" role="status" data-filter-status></p>
    <div class="project-grid">
      {projects.map(({ id, data }) => <article class={`project-card project-${data.illustration}`} data-category={data.category}>
        <a class:list={['project-image', { 'has-photo': data.cover }]} href={`/projects/${id}/`} aria-label={`Explore ${data.title}`}>
          <div class="art-meta"><span>0{data.order} / {data.category.toUpperCase()}</span><span class="art-arrow" aria-hidden="true">↗</span></div>
          {data.cover ? <img class="project-photo" src={data.cover.thumbnail ?? data.cover.src} alt={data.cover.alt} width={data.cover.width} height={data.cover.height} loading="lazy" decoding="async" /> : <Illustration kind={data.illustration}/>}
          <span class="art-caption">{data.cover ? 'FROM THE WORKBENCH / PROJECT PHOTOGRAPH' : 'CONCEPT DIAGRAM / NOT PROJECT FOOTAGE'}</span>
        </a>
        <div class="project-text"><p class="eyebrow">{data.organisation}</p><h3><a href={`/projects/${id}/`}>{data.title} <span aria-hidden="true">↗</span></a></h3><p>{data.summary}</p><ul class="tags" aria-label={`${data.title} technologies`}>{data.tags.slice(0,4).map((tag)=><li>{tag}</li>)}</ul></div>
      </article>)}
    </div>
  </section>

  <section class="experience-section section" id="experience" aria-labelledby="experience-title"><div class="container experience-layout">
    <div class="experience-intro"><p class="eyebrow">02 / OUT IN THE REAL WORLD</p><h2 id="experience-title">Better built<br />together.</h2><p>Lab benches, student teams and industry projects. Learning by doing, alongside people who care about the details.</p><a class="text-link" href="/resume.pdf" download="Abbas_Quettawala_Resume.pdf">The full resume <span aria-hidden="true">↓</span></a></div>
    <div class="experience-list">{experience.map((item)=><article class="experience-item"><div class="experience-top"><h3>{item.name}</h3><span class="eyebrow">{item.date}</span></div><p class="experience-role">{item.title}</p><p>{item.text}</p><span class="eyebrow experience-tag">{item.tag}</span></article>)}</div>
  </div></section>

  <section class="section container bench-section" aria-labelledby="bench-title"><div class="section-heading"><div><p class="eyebrow">03 / ON THE WORKBENCH</p><h2 id="bench-title">Curiosity doesn’t clock out.</h2></div><p>Smaller builds. Open questions.<br />Things I can’t leave alone.</p></div>
    <div class="bench-list">
      <article><span class="bench-icon" aria-hidden="true">⌘</span><div><h3>ESP mini drones</h3><p>Exploring ESP32 hardware and firmware for onboard sensing and flight control.</p></div><span class="status-tag">In development</span></article>
      <article><span class="bench-icon" aria-hidden="true">◉</span><div><h3>AI desk buddy</h3><p>A Pi 4 and Pi Camera companion, with face tracking and PC-assisted conversation in development.</p></div><span class="status-tag">In development</span></article>
      <article><span class="bench-icon" aria-hidden="true">▤</span><div><h3>Homelab & automation</h3><p>A repurposed PC, Proxmox, news automation and a Kubernetes deployment in progress.</p></div><span class="status-tag">In development</span></article>
      <article><span class="bench-icon" aria-hidden="true">♫</span><div><h3>MuseMender</h3><p>A Python/PySide6 tool turning printed scores, PDFs and sheet-music videos into editable MuseScore files.</p></div><span class="status-tag built">Working local tool</span></article>
    </div>
  </section>

  <section class="section container about-section" id="about" aria-labelledby="about-title">
    <figure class="about-portrait">
      <p class="eyebrow">THE PERSON BEHIND THE PROJECTS</p>
      <a href="/media/about/abbas-robotics-lab.webp" aria-label="View full portrait of Abbas in the robotics lab">
        <img src="/media/about/abbas-robotics-lab.webp" srcset="/media/about/abbas-robotics-lab-small.webp 500w, /media/about/abbas-robotics-lab.webp 1000w" sizes="(max-width: 520px) calc(100vw - 64px), (max-width: 780px) 40vw, 45vw" width="1000" height="1500" alt="Abbas smiling beside a KUKA robot in the Monash Automation lab" loading="lazy" decoding="async" />
      </a>
      <figcaption><span>ABBAS QUETTAWALA</span><span>MONASH AUTOMATION</span></figcaption>
    </figure>
    <div class="about-copy"><p class="eyebrow">04 / A BIT ABOUT ME</p><h2 id="about-title">An engineer.<br />A tinkerer.<br />A work in progress.</h2><p>I like understanding how things work—and then finding out what happens when I change them. That curiosity takes me from robot mechanisms and firmware to game mods and learning algorithms.</p><p>I’m completing my Bachelor of Mechatronics Engineering (Honours) at Monash, with graduation expected in mid-2027. Teaching maths and coding has also taught me to make complicated ideas feel less intimidating.</p><p>Away from the workbench: piano, trumpet, video editing, and the occasional over-prepared trivia night.</p><div class="about-links"><a class="text-link" href="https://github.com/AbbasQuettawala" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a class="text-link" href="https://www.linkedin.com/in/abbas-quettawala/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
    <div class="about-gallery" role="group" aria-label="Photos from the robotics lab">
      <figure><a href="/media/about/robotics-demonstration.webp" aria-label="View full robotics demonstration photograph"><img src="/media/about/robotics-demonstration.webp" width="1200" height="797" alt="Abbas discussing a robotics display with visitors, with a robot model on screen and hardware on the workbench" loading="lazy" decoding="async" /></a><figcaption><span class="eyebrow">FROM SCREEN TO WORKBENCH</span>Sharing our robotics work with visitors.</figcaption></figure>
      <figure><a href="/media/about/sharing-the-build.webp" aria-label="View full lab discussion photograph"><img src="/media/about/sharing-the-build.webp" width="1200" height="797" alt="Abbas speaking with visitors beside robot mechanisms and project displays in the Monash Automation lab" loading="lazy" decoding="async" /></a><figcaption><span class="eyebrow">ENGINEERING IS A CONVERSATION</span>A closer look at the projects with Monash Automation.</figcaption></figure>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="container"><p class="eyebrow">05 / YOUR NEXT TEAMMATE?</p><div class="contact-heading"><h2 id="contact-title">Let’s build<br />something <em>real.</em></h2><a class="contact-arrow" href="mailto:abbasquettawalla@gmail.com" aria-label="Email Abbas"><span aria-hidden="true">↗</span></a></div><div class="contact-bottom"><a href="mailto:abbasquettawalla@gmail.com">abbasquettawalla@gmail.com</a><p>Robotics, mechatronics, AI.<br />Good conversations start somewhere.</p></div></div></section>
</Layout>
<script>
  const controls = document.querySelector<HTMLElement>('[data-filters]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  if (controls) {
    controls.hidden = false;
    controls.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!button) return;
      const filter = button.dataset.filter;
      controls.querySelectorAll('button').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      let count = 0;
      cards.forEach((card) => { card.hidden = filter !== 'All' && card.dataset.category !== filter; if (!card.hidden) count++; });
      if (status) status.textContent = `${count} projects shown${filter === 'All' ? '' : ` in ${filter}`}.`;
    });
  }
</script>
